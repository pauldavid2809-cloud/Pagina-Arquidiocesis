{
  "rewrites": [
    { "source": "/api/instagram", "destination": "/api/instagram" },
    { "source": "/api/send-email", "destination": "/api/send-email" },
    { "source": "/api/generate-document", "destination": "/api/generate-document" },
    { "source": "/api/config", "destination": "/api/config" },
    { "source": "/api/login", "destination": "/api/login" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=600" }
      ]
    }
  ]
}

